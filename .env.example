# ==============================================================================
# TenderLens Environment Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# ------------------------------------------------------------------------------
# Database Connection (Neon Serverless PostgreSQL or Local Postgres)
# ------------------------------------------------------------------------------
# For Neon Postgres, paste your pooled connection string:
DATABASE_URL=postgres://neondb_owner:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Direct unpooled connection (optional, used for migrations):
# DATABASE_URL_UNPOOLED=postgres://neondb_owner:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Neon branch identifiers (optional, automatically populated by neon init):
# NEON_BRANCH=production
# NEON_BRANCH_ID=br-xxxx

# ------------------------------------------------------------------------------
# Redis & Celery Broker (Optional for web UI, required for background crawl worker)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Email & Alerts
# ------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=tenderlens@localhost

# ------------------------------------------------------------------------------
# Demo Users & Seed Credentials (Local Development Only)
# ------------------------------------------------------------------------------
DEMO_USERNAME=demo
DEMO_PASSWORD=demo-tenderlens
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@localhost
DJANGO_SUPERUSER_PASSWORD=admin-tenderlens

# ------------------------------------------------------------------------------
# Crawler Configuration
# ------------------------------------------------------------------------------
CRAWL_DELAY_SECONDS=2
